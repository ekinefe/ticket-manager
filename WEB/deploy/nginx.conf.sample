# Reverse-proxy sample for Ticket Manager (TLS termination).
# The Node server itself binds plain HTTP on 127.0.0.1:8788.
#
# Notes:
#  - client_max_body_size must exceed the 100 MB upload limit.
#  - X-Forwarded-For is read by the rate limiter.

server {
    listen 80;
    server_name tickets.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tickets.example.com;

    # ssl_certificate     /etc/letsencrypt/live/tickets.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tickets.example.com/privkey.pem;

    client_max_body_size 110m;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
