{
  "name": "ticket-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run -s gen:templates && tsx watch server/main.ts",
    "start": "tsx server/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "backup": "tsx scripts/backup.ts",
    "media:gc": "tsx scripts/media-gc.ts",
    "gen:templates": "tsx scripts/gen-templates.ts",
    "db:seed": "npm run -s gen:templates && tsx seed/seed.ts",
    "db:reset": "node -e \"const fs=require('fs');fs.rmSync('data',{recursive:true,force:true});fs.rmSync('.mail-out',{recursive:true,force:true});\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-auth": "^1.3.4",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
